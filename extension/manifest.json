{
  "manifest_version": 3,
  "name": "Course Subtitle Translator",
  "version": "1.1",
  "description": "Realtime Subtitle Translator for Coursera, Udemy and online learning platforms using Native Rust Backend",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Course Subtitle Translator"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["*://*.coursera.org/*", "*://*.udemy.com/*"],
      "js": ["websocket-client.js", "subtitle-adapter.js", "content.js"]
    }
  ]
}